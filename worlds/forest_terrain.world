<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="forest_outdoor_world">

    <physics type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <ambient>0.6 0.6 0.6 1.0</ambient>
      <background>0.7 0.8 0.9 1.0</background>
      <shadows>false</shadows>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
    </scene>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>8.0 -8.0 6.0 0 0.55 2.2</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>120 120</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>120 120</size></plane></geometry>
          <material><ambient>0.25 0.38 0.15 1.0</ambient><diffuse>0.3 0.45 0.2 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Forest Dirt Trail -->
    <model name="forest_trail">
      <static>true</static>
      <pose>0 0 0.005 0 0 0</pose>
      <link name="trail_link">
        <visual name="segment_1">
          <pose>5 0 0 0 0 0</pose>
          <geometry><box><size>12 2.5 0.01</size></box></geometry>
          <material><ambient>0.45 0.35 0.22 1.0</ambient><diffuse>0.5 0.38 0.25 1.0</diffuse></material>
        </visual>
        <visual name="segment_2">
          <pose>14 3 0 0 0 0.6</pose>
          <geometry><box><size>10 2.5 0.01</size></box></geometry>
          <material><ambient>0.45 0.35 0.22 1.0</ambient><diffuse>0.5 0.38 0.25 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Trees -->
    <model name="tree_1">
      <static>true</static><pose>3 2.8 0 0 0 0</pose>
      <link name="trunk">
        <collision name="col"><pose>0 0 1.5 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="trunk_vis"><pose>0 0 1.5 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>3.0</length></cylinder></geometry><material><ambient>0.35 0.22 0.12 1.0</ambient><diffuse>0.4 0.25 0.15 1.0</diffuse></material></visual>
        <visual name="foliage"><pose>0 0 3.2 0 0 0</pose><geometry><sphere><radius>1.6</radius></sphere></geometry><material><ambient>0.1 0.35 0.1 1.0</ambient><diffuse>0.12 0.42 0.12 1.0</diffuse></material></visual>
      </link>
    </model>

    <model name="tree_2">
      <static>true</static><pose>4 -2.5 0 0 0 0</pose>
      <link name="trunk">
        <collision name="col"><pose>0 0 1.5 0 0 0</pose><geometry><cylinder><radius>0.32</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="trunk_vis"><pose>0 0 1.5 0 0 0</pose><geometry><cylinder><radius>0.32</radius><length>3.0</length></cylinder></geometry><material><ambient>0.35 0.22 0.12 1.0</ambient><diffuse>0.4 0.25 0.15 1.0</diffuse></material></visual>
        <visual name="foliage"><pose>0 0 3.2 0 0 0</pose><geometry><sphere><radius>1.7</radius></sphere></geometry><material><ambient>0.09 0.33 0.09 1.0</ambient><diffuse>0.11 0.4 0.11 1.0</diffuse></material></visual>
      </link>
    </model>

    <!-- Boulders -->
    <model name="rock_boulder_1">
      <static>true</static><pose>6.5 -1.2 0.35 0.2 0.3 0.7</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.9 0.8 0.7</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.9 0.8 0.7</size></box></geometry><material><ambient>0.45 0.45 0.45 1.0</ambient><diffuse>0.5 0.5 0.5 1.0</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
